# ==========================================
# NBA LIVE — Environment Variables
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nba_live
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nba_live
POSTGRES_PORT=5432

# Frontend Port Configuration
WEB_PORT=3000

# NBA Data Provider ('mock' or 'balldontlie')
# 'mock': Simula partidas ao vivo, progressão de placares, tempos e eventos SSE para demonstração
# 'balldontlie': Consulta a API real pública da BallDontLie (requer BALLDONTLIE_API_KEY)
NBA_PROVIDER=mock

# BallDontLie API Key (Opcional se NBA_PROVIDER=mock)
# Obtenha sua chave em: https://docs.balldontlie.io/
BALLDONTLIE_API_KEY=

# Frequência de sincronização do worker em milissegundos (padrão: 10 segundos)
SYNC_INTERVAL_MS=10000
