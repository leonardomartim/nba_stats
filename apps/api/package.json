    "db:seed": "bun src/infrastructure/db/seed.ts"
  },
  "dependencies": {
    "@nba-live/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3"
  }
