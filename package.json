{
  "name": "nba-live-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter \"*\" dev",
    "dev:api": "bun --filter @nba-live/api dev",
    "dev:web": "bun --filter @nba-live/web dev",
    "build": "bun --filter \"*\" build",
    "test": "bun --filter @nba-live/api test",
    "db:generate": "bun --filter @nba-live/api db:generate",
    "db:migrate": "bun --filter @nba-live/api db:migrate",
    "db:seed": "bun --filter @nba-live/api db:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
